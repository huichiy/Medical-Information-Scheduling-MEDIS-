digraph UseCase {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, labelloc="t",
         label="MEDIS Hospital Management System — Use Case Diagram"];
  node  [fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=9, color="#444444"];

  // Actors
  node [shape=plaintext];
  admin [label="Admin",        shape=box, style="rounded,filled", fillcolor="#dbeafe"];
  doctor[label="Doctor",       shape=box, style="rounded,filled", fillcolor="#dcfce7"];
  recep [label="Receptionist", shape=box, style="rounded,filled", fillcolor="#fef9c3"];

  // System boundary
  subgraph cluster_system {
    label="MEDIS System";
    style="rounded";
    color="#94a3b8";
    fontname="Helvetica";
    node [shape=ellipse, style=filled, fillcolor="#f1f5f9", color="#64748b"];

    UC_login   [label="Login"];
    UC_logout  [label="Logout"];
    UC_addpat  [label="Add / Update\nPatient"];
    UC_viewpat [label="View Patient\nRecords"];
    UC_adddoc  [label="Add / View\nDoctors"];
    UC_book    [label="Book\nAppointment"];
    UC_viewappt[label="View Appointment\nList"];
    UC_cancel  [label="Cancel\nAppointment"];
    UC_report  [label="View Reports"];
  }

  // Associations (actor -> use case)
  admin  -> UC_addpat;
  admin  -> UC_viewpat;
  admin  -> UC_adddoc;
  admin  -> UC_book;
  admin  -> UC_viewappt;
  admin  -> UC_report;

  doctor -> UC_viewappt;
  doctor -> UC_viewpat;

  recep  -> UC_addpat;
  recep  -> UC_viewpat;
  recep  -> UC_book;
  recep  -> UC_viewappt;

  // All actors can log in / out
  admin  -> UC_login;
  doctor -> UC_login;
  recep  -> UC_login;
  admin  -> UC_logout [style=invis];

  // include / extend
  edge [style=dashed, fontcolor="#b91c1c", color="#b91c1c"];
  UC_addpat   -> UC_login   [label="<<include>>"];
  UC_book     -> UC_login   [label="<<include>>"];
  UC_report   -> UC_login   [label="<<include>>"];
  UC_cancel   -> UC_viewappt[label="<<extend>>", dir=back];
}
