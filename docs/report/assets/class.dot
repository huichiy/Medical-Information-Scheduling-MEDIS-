digraph ClassDiagram {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=14, labelloc="t", nodesep=0.5, ranksep=0.8,
         label="MEDIS Hospital Management System — Class Diagram"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9];

  /* ===================== MODEL ===================== */
  User [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><I>«abstract»</I><BR/><B>User</B></TD></TR>
      <TR><TD ALIGN="LEFT">#userId : int<BR ALIGN="LEFT"/>#username : String<BR ALIGN="LEFT"/>#passwordHash : String<BR ALIGN="LEFT"/>#role : String<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+getUserId() : int<BR ALIGN="LEFT"/>+getRole() : String<BR ALIGN="LEFT"/>+dashboardTitle() : String {abstract}<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Admin [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><B>Admin</B></TD></TR>
      <TR><TD ALIGN="LEFT">+dashboardTitle() : String<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Receptionist [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><B>Receptionist</B></TD></TR>
      <TR><TD ALIGN="LEFT">+dashboardTitle() : String<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Doctor [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><B>Doctor</B></TD></TR>
      <TR><TD ALIGN="LEFT">-doctorId : int<BR ALIGN="LEFT"/>-name : String<BR ALIGN="LEFT"/>-specialization : String<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+getDoctorId() : int<BR ALIGN="LEFT"/>+getSpecialization() : String<BR ALIGN="LEFT"/>+toString() : String<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Patient [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><B>Patient</B></TD></TR>
      <TR><TD ALIGN="LEFT">-patientId : int<BR ALIGN="LEFT"/>-name : String<BR ALIGN="LEFT"/>-age : int<BR ALIGN="LEFT"/>-gender : String<BR ALIGN="LEFT"/>-medicalHistory : String<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+getMedicalHistory() : String<BR ALIGN="LEFT"/>+setName(String)<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Appointment [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><B>Appointment</B></TD></TR>
      <TR><TD ALIGN="LEFT">-appointmentId : int<BR ALIGN="LEFT"/>-dateTime : LocalDateTime<BR ALIGN="LEFT"/>-status : Status<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+getStatus() : Status<BR ALIGN="LEFT"/>+setStatus(Status)<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Status [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fae8ff">
      <TR><TD><I>«enumeration»</I><BR/><B>Status</B></TD></TR>
      <TR><TD ALIGN="LEFT">SCHEDULED<BR ALIGN="LEFT"/>COMPLETED<BR ALIGN="LEFT"/>CANCELLED<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  Result [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#eef2ff">
      <TR><TD><B>Result</B></TD></TR>
      <TR><TD ALIGN="LEFT">-ok : boolean<BR ALIGN="LEFT"/>-message : String<BR ALIGN="LEFT"/>-data : Object<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+ok() : Result {static}<BR ALIGN="LEFT"/>+fail(String) : Result {static}<BR ALIGN="LEFT"/>+isOk() : boolean<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  /* ===================== CONTROLLER ===================== */
  SystemController [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ecfccb">
      <TR><TD><B>SystemController</B></TD></TR>
      <TR><TD ALIGN="LEFT">-currentUser : User<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+login() : LoginController<BR ALIGN="LEFT"/>+patient() : PatientController<BR ALIGN="LEFT"/>+appointment() : AppointmentController<BR ALIGN="LEFT"/>+setCurrentUser(User)<BR ALIGN="LEFT"/>+logout()<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  LoginController [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ecfccb">
      <TR><TD><B>LoginController</B></TD></TR>
      <TR><TD ALIGN="LEFT">+authenticate(String, String) : Result<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  PatientController [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ecfccb">
      <TR><TD><B>PatientController</B></TD></TR>
      <TR><TD ALIGN="LEFT">+add(...) : Result<BR ALIGN="LEFT"/>+update(...) : Result<BR ALIGN="LEFT"/>+getAll() : List&lt;Patient&gt;<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  DoctorController [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ecfccb">
      <TR><TD><B>DoctorController</B></TD></TR>
      <TR><TD ALIGN="LEFT">+add(String, String) : Result<BR ALIGN="LEFT"/>+getAll() : List&lt;Doctor&gt;<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  AppointmentController [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ecfccb">
      <TR><TD><B>AppointmentController</B></TD></TR>
      <TR><TD ALIGN="LEFT">+book(int, int, LocalDateTime) : Result<BR ALIGN="LEFT"/>+cancel(int) : Result<BR ALIGN="LEFT"/>+getAll() : List&lt;Appointment&gt;<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  ReportController [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ecfccb">
      <TR><TD><B>ReportController</B></TD></TR>
      <TR><TD ALIGN="LEFT">+totalPatients() : int<BR ALIGN="LEFT"/>+totalAppointments() : int<BR ALIGN="LEFT"/>+doctorSchedules() : Map<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  /* ===================== DAO ===================== */
  UserDAO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fee2e2">
      <TR><TD><I>«interface»</I><BR/><B>UserDAO</B></TD></TR>
      <TR><TD ALIGN="LEFT">+findByUsername(String) : Optional&lt;User&gt;<BR ALIGN="LEFT"/>+findAll() : List&lt;User&gt;<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];
  PatientDAO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fee2e2">
      <TR><TD><I>«interface»</I><BR/><B>PatientDAO</B></TD></TR>
      <TR><TD ALIGN="LEFT">+insert/update/findById/findAll<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];
  DoctorDAO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fee2e2">
      <TR><TD><I>«interface»</I><BR/><B>DoctorDAO</B></TD></TR>
      <TR><TD ALIGN="LEFT">+insert/update/findById/findAll<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];
  AppointmentDAO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#fee2e2">
      <TR><TD><I>«interface»</I><BR/><B>AppointmentDAO</B></TD></TR>
      <TR><TD ALIGN="LEFT">+insert/findAll/findByDoctor<BR ALIGN="LEFT"/>+existsByDoctorAndTime(...)<BR ALIGN="LEFT"/>+updateStatus(...)<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  UserDAOImpl        [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffe4e6"><TR><TD><B>UserDAOImpl</B></TD></TR></TABLE>>];
  PatientDAOImpl     [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffe4e6"><TR><TD><B>PatientDAOImpl</B></TD></TR></TABLE>>];
  DoctorDAOImpl      [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffe4e6"><TR><TD><B>DoctorDAOImpl</B></TD></TR></TABLE>>];
  AppointmentDAOImpl [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#ffe4e6"><TR><TD><B>AppointmentDAOImpl</B></TD></TR></TABLE>>];

  /* ===================== DB / UTIL ===================== */
  DatabaseConnection [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e0f2fe">
      <TR><TD><I>«singleton»</I><BR/><B>DatabaseConnection</B></TD></TR>
      <TR><TD ALIGN="LEFT">-instance : DatabaseConnection<BR ALIGN="LEFT"/>-conn : Connection<BR ALIGN="LEFT"/></TD></TR>
      <TR><TD ALIGN="LEFT">+getInstance() : DatabaseConnection {static}<BR ALIGN="LEFT"/>+get() : Connection<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];
  Validator [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e0f2fe">
      <TR><TD><I>«utility»</I><BR/><B>Validator</B></TD></TR>
      <TR><TD ALIGN="LEFT">+isNotBlank(String) : boolean {static}<BR ALIGN="LEFT"/>+isAgeValid(int) : boolean {static}<BR ALIGN="LEFT"/>+isFutureDate(LocalDateTime) : boolean {static}<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];
  PasswordHasher [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="#e0f2fe">
      <TR><TD><I>«utility»</I><BR/><B>PasswordHasher</B></TD></TR>
      <TR><TD ALIGN="LEFT">+hash(String) : String {static}<BR ALIGN="LEFT"/>+verify(String, String) : boolean {static}<BR ALIGN="LEFT"/></TD></TR>
    </TABLE>>];

  /* ===================== RELATIONSHIPS ===================== */
  // Inheritance (generalization): hollow triangle
  edge [arrowhead=onormal, style=solid, color="#1e3a8a"];
  Admin        -> User;
  Receptionist -> User;
  Doctor       -> User;

  // Realization (implements): hollow triangle + dashed
  edge [arrowhead=onormal, style=dashed, color="#b91c1c"];
  UserDAOImpl        -> UserDAO;
  PatientDAOImpl     -> PatientDAO;
  DoctorDAOImpl      -> DoctorDAO;
  AppointmentDAOImpl -> AppointmentDAO;

  // Association: Appointment -> Patient / Doctor (1)
  edge [arrowhead=vee, style=solid, color="#334155", headlabel="1", fontcolor="#334155"];
  Appointment -> Patient [taillabel="*"];
  Appointment -> Doctor  [taillabel="*"];
  edge [headlabel="", taillabel=""];

  // Composition: Appointment ◆— Status (enum owned)
  edge [arrowhead=none, arrowtail=diamond, dir=back, style=solid, color="#7c3aed"];
  Appointment -> Status;

  // Aggregation: SystemController ◇— the five controllers
  edge [arrowhead=none, arrowtail=odiamond, dir=back, style=solid, color="#047857"];
  SystemController -> LoginController;
  SystemController -> PatientController;
  SystemController -> DoctorController;
  SystemController -> AppointmentController;
  SystemController -> ReportController;

  // Association: SystemController -> currentUser
  edge [arrowhead=vee, arrowtail=none, dir=forward, style=solid, color="#334155"];
  SystemController -> User [label="currentUser"];

  // Dependencies: controllers -> DAO interfaces
  edge [arrowhead=vee, style=dashed, color="#94a3b8"];
  LoginController       -> UserDAO;
  PatientController     -> PatientDAO;
  DoctorController      -> DoctorDAO;
  AppointmentController -> AppointmentDAO;
  AppointmentController -> PatientDAO;
  AppointmentController -> DoctorDAO;
  ReportController      -> PatientDAO;
  ReportController      -> DoctorDAO;
  ReportController      -> AppointmentDAO;

  // Dependencies: controllers -> util / model.Result
  LoginController -> PasswordHasher;
  LoginController -> Validator;
  PatientController -> Validator;
  AppointmentController -> Validator;

  // DAO impls depend on DatabaseConnection
  UserDAOImpl        -> DatabaseConnection;
  PatientDAOImpl     -> DatabaseConnection;
  DoctorDAOImpl      -> DatabaseConnection;
  AppointmentDAOImpl -> DatabaseConnection;
}
