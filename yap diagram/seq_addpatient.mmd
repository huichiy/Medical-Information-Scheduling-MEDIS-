%% MEDIS — Sequence Diagram 3: Add Patient
sequenceDiagram
    autonumber
    actor Recep as Receptionist
    participant PP as PatientPanel
    participant PC as PatientController
    participant PDAO as PatientDAO
    participant DB as Database

    Recep->>PP: fill name/age/gender/history; click Add
    PP->>PP: parse age (NumberFormat)
    PP->>PC: add(name, age, gender, history)
    PC->>PC: Validator.isNotBlank / isAgeValid

    alt valid input
        PC->>PDAO: insert(new Patient(...))
        PDAO->>DB: INSERT ... RETURN_GENERATED_KEYS
        DB-->>PDAO: generated patient_id
        PDAO-->>PC: Result.ok(patient)
        PC-->>PP: Result -> showInfo + refresh()
    else validation fails
        PC-->>PP: Result.fail(msg)
        PP->>PP: DialogHelper.showError(msg)
    end
