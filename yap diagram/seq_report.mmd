%% MEDIS — Sequence Diagram 4: Generate Report
sequenceDiagram
    autonumber
    actor Admin
    participant RP as ReportPanel
    participant RC as ReportController
    participant DAO as DAO layer
    participant DB as Database

    Admin->>RP: click Refresh Report

    RP->>RC: totalPatients()
    RC->>DAO: PatientDAO.findAll()
    DAO->>DB: SELECT * FROM patients
    DB-->>DAO: rows
    DAO-->>RC: List[Patient]
    RC-->>RP: count = list.size()

    RP->>RC: totalAppointments()
    RC->>DAO: AppointmentDAO.findAll()
    DAO->>DB: SELECT * FROM appointments
    DB-->>DAO: rows
    DAO-->>RC: List[Appointment]
    RC-->>RP: count = list.size()

    RP->>RC: doctorSchedules()
    loop for each doctor
        RC->>DAO: AppointmentDAO.findByDoctor(id)
        DAO->>DB: SELECT ... WHERE doctor_id = ?
        DB-->>RC: List[Appointment]
    end
    RC-->>RP: Map[Doctor, List[Appointment]]
    Note over RP: update total labels + schedule table
