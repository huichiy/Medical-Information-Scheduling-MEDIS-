digraph UseCase {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=12, labelloc="t",
         label="MEDIS Hospital Management System — Use Case Diagram"];
  node  [fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=9, color="#444444"];

  // Actors
  node [shape=box, style="rounded,filled"];
  admin [label="Admin",        fillcolor="#dbeafe"];
  doctor[label="Doctor",       fillcolor="#dcfce7"];
  recep [label="Receptionist", fillcolor="#fef9c3"];

  // System boundary
  subgraph cluster_system {
    label="MEDIS System";
    style="rounded";
    color="#94a3b8";
    fontname="Helvetica";
    node [shape=ellipse, style=filled, fillcolor="#f1f5f9", color="#64748b"];

    UC_login   [label="Login"];
    UC_logout  [label="Logout"];
    UC_addpat  [label="Add / Update\nPatient"];
    UC_viewpat [label="View Patient\nRecords"];
    UC_adddoc  [label="Add / View\nDoctors"];
    UC_book    [label="Book\nAppointment"];
    UC_viewappt[label="View Appointment\nList"];
    UC_cancel  [label="Cancel\nAppointment"];
    UC_report  [label="View Reports"];

    // Login is a PRECONDITION of the other use cases, not an <<include>>:
    // the actor authenticates once per session, not once per use case.
    precond [shape=note, style=filled, fillcolor="#fef9c3", color="#b45309",
             fontsize=9,
             label="<<precondition>>\nAll use cases require the\nactor to be logged in"];
  }

  // Actor–use case associations: plain undirected lines (correct UML)
  edge [arrowhead=none, color="#334155"];
  admin  -> UC_login;
  admin  -> UC_logout;
  admin  -> UC_addpat;
  admin  -> UC_viewpat;
  admin  -> UC_adddoc;
  admin  -> UC_book;
  admin  -> UC_viewappt;
  admin  -> UC_report;

  // Doctor gets the same Patients + Appointments panels as Receptionist
  // (DashboardFrame), so the capabilities are identical.
  doctor -> UC_login;
  doctor -> UC_logout;
  doctor -> UC_addpat;
  doctor -> UC_viewpat;
  doctor -> UC_book;
  doctor -> UC_viewappt;

  recep  -> UC_login;
  recep  -> UC_logout;
  recep  -> UC_addpat;
  recep  -> UC_viewpat;
  recep  -> UC_book;
  recep  -> UC_viewappt;

  // Note anchor: dashed line, no arrowhead (UML note attachment)
  edge [style=dashed, arrowhead=none, color="#b45309"];
  precond -> UC_login;

  // <<extend>>: extending use case (Cancel) --> base use case (View Appt List)
  edge [style=dashed, arrowhead=vee, fontcolor="#b91c1c", color="#b91c1c"];
  UC_cancel -> UC_viewappt [label="<<extend>>"];
}
