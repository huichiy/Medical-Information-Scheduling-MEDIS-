%% MEDIS — Sequence Diagram 2: Book Appointment
sequenceDiagram
    autonumber
    actor Recep as Receptionist
    participant AP as AppointmentPanel
    participant AC as AppointmentController
    participant PDDAO as Patient/DoctorDAO
    participant ADAO as AppointmentDAO
    participant DB as Database

    Recep->>AP: select patient, doctor, datetime; click Book
    AP->>AP: parse datetime (FMT)
    AP->>AC: book(patientId, doctorId, dt)
    AC->>AC: Validator.isFutureDate(dt)
    AC->>PDDAO: findById(...)
    PDDAO-->>AC: Optional[Patient] / Optional[Doctor]
    AC->>ADAO: existsByDoctorAndTime(doctorId, dt)
    ADAO->>DB: SELECT COUNT(*) ...
    DB-->>ADAO: 0
    ADAO-->>AC: false (slot free)

    alt valid and slot free
        AC->>ADAO: insert(appointment)
        ADAO->>DB: INSERT (UNIQUE doctor_id + datetime)
        ADAO-->>AC: Result.ok(appt)
        AC-->>AP: Result -> showInfo + refresh()
    else past date / slot already taken
        AC-->>AP: Result.fail(msg)
        AP->>AP: DialogHelper.showError(msg)
    end
