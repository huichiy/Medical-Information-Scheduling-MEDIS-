@startuml seq_report
' Sequence 4 — Generate Report (from ReportController)
skinparam dpi 140
skinparam shadowing false
title Sequence Diagram 4 — Generate Report

actor Admin as A
participant "ReportPanel" as V
participant "ReportController" as C
participant "PatientDAO" as PD
participant "AppointmentDAO" as AD
participant "DoctorDAO" as DD
database "SQLite\n(medis.db)" as DB

A -> V : click Refresh Report

V -> C : totalPatients()
C -> PD : findAll()
PD -> DB : SELECT * FROM patients
DB --> PD : rows
PD --> C : List<Patient>
C --> V : list.size()

V -> C : totalAppointments()
C -> AD : findAll()
AD -> DB : SELECT * FROM appointments
DB --> AD : rows
AD --> C : List<Appointment>
C --> V : list.size()

V -> C : doctorSchedules()
C -> DD : findAll()
DD --> C : List<Doctor>
loop for each doctor
  C -> AD : findByDoctor(doctorId)
  AD -> DB : SELECT ... WHERE doctor_id = ?
  DB --> AD : rows
  AD --> C : List<Appointment>
end
C --> V : Map<Doctor, List<Appointment>>
V -> V : update labels + schedule table

@enduml
