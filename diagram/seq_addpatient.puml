@startuml seq_addpatient
' Sequence 3 — Add Patient (from PatientController.add)
skinparam dpi 140
skinparam shadowing false
title Sequence Diagram 3 — Add Patient

actor Receptionist as A
participant "PatientPanel" as V
participant "PatientController" as C
participant "PatientDAO" as D
database "SQLite\n(medis.db)" as DB

A -> V : fill name/age/gender/history; click Add
V -> V : parse age (Integer.parseInt)
V -> C : add(name, age, gender, history)
C -> C : Validator.isNotBlank(name/gender)
C -> C : Validator.isAgeValid(age)  // 0-150

alt validation passes
  C -> D : insert(new Patient(name, age, gender, history))
  D -> DB : INSERT INTO patients (RETURN_GENERATED_KEYS)
  DB --> D : generated patient_id
  D --> C : Result.ok(patient)
  C --> V : Result.ok
  V -> V : DialogHelper.showInfo + refresh()
else validation fails
  C --> V : Result.fail(msg)
  V -> V : DialogHelper.showError(msg)
end

@enduml
